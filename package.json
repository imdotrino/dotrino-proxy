{
  "name": "websocket-proxy",
  "version": "1.0.1",
  "description": "WebSocket proxy with UUID validation using ws ",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --exec node server.js",
    "dev:env": "nodemon -r dotenv/config server.js",
    "dev-screen": "./dev-screen.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dotrino/identity": "0.56.0",
    "@dotrino/proxy-client": "0.10.1",
    "@dotrino/vault": "0.28.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": [
    "websocket",
    "proxy",
    "ws"
  ],
  "author": "",
  "license": "MIT"
}
