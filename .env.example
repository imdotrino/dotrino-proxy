# Puerto del proxy WebSocket
PORT=4001

# --- Web Push (VAPID) ---
# OPCIONAL: si dejás estas dos vacías, el proxy autogenera un par la primera vez
# y lo persiste en SQLite (estable entre reinicios). Definilas solo si querés
# control explícito o compartir el mismo par entre varias instancias.
# Generá un par con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Base SQLite donde se persiste lo durable (cola offline + push subscriptions)
PROXY_DB_FILE=./proxy-data.db

# --- Federación s2s (varios proxies que se reenvían mensajes) ---
# Sin PROXY_PEERS el proxy NO reenvía nada a nadie (nodo suelto). Esta variable
# faltaba en este archivo y por eso el nodo principal de producción corrió meses
# sin federar sin que se notara: revisá `GET /peers` para ver el estado real.
# Lista separada por comas, sin barra final.
PROXY_PEERS=
# URL pública de ESTE nodo (la que anuncia en GET /node). Opcional pero
# recomendable: es lo que un peer usa para saber cómo se llama a sí mismo.
PROXY_PUBLIC_URL=
# Prefijo de nodo: 2 caracteres de 123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ. Si se
# deja vacío se DERIVA de la pubkey del nodo (verificable, no exclusivo).
PROXY_NODE_PREFIX=
#
# NO hay secreto compartido de federación: los nodos se autentican FIRMANDO con
# la llave del vault (vault-service/service-identity.json, ver enroll-vault.js).
# El viejo PROXY_FEDERATION_TOKEN quedó eliminado — un secreto simétrico no
# distinguía QUÉ nodo hablaba, así que quien lo tuviera podía suplantar a todos.

# --- TURN temporal (Cloudflare Realtime) ---
# OPCIONAL: sin estas dos llaves la op `turn-credentials` responde enabled:false
# y los clientes WebRTC quedan STUN-only. Crear la TURN key en el dashboard de
# Cloudflare (Realtime -> TURN). La llave NUNCA sale del servidor: a los
# clientes identificados se les emiten credenciales efímeras.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# Vida de cada credencial emitida, en segundos (default 600, rango 60-86400)
TURN_TTL_SECONDS=600
# Emisiones por pubkey/hora (default 12)
TURN_MAX_PER_HOUR=12
