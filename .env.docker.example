# Copiá a `.env` y completá. Lo lee docker-compose.yml.

# Tu dominio para el proxy (debe apuntar A/AAAA a este host; 80/443 abiertos).
# DNS DIRECTO, sin nube naranja de Cloudflare (corta los WebSocket de larga vida).
PROXY_DOMAIN=proxy.tudominio.com

# Email de contacto para VAPID (Web Push).
VAPID_SUBJECT=mailto:vos@tudominio.com

# Opcional: par VAPID explícito. Si lo dejás vacío, el proxy lo autogenera y lo
# persiste en la base SQLite (estable mientras conserves el volumen proxy-data).
# Generar: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
